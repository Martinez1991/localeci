    { "id": "icu.plural.pl", "source": "{count, plural, one {# file} other {# files}}", "targetLocale": "pl", "reference": "{count, plural, one {# plik} few {# pliki} many {# plików} other {# pliku}}", "traps": ["icu-plural", "polish-few"] },
    { "id": "icu.plural.ja", "source": "{count, plural, one {# item} other {# items}}", "targetLocale": "ja", "reference": "{count, plural, other {#個の商品}}", "traps": ["icu-plural", "japanese-other-only"] },
    { "id": "icu.select.gender", "source": "{gender, select, male {He} female {She} other {They}} liked your post", "targetLocale": "de", "reference": "{gender, select, male {Er} female {Sie} other {Sie}} hat deinen Beitrag geliked", "traps": ["icu-select"] },
    { "id": "html.link", "source": "Read our <0>privacy policy</0>", "targetLocale": "pt-BR", "reference": "Leia nossa <0>política de privacidade</0>", "traps": ["html", "tag-index"] },
    { "id": "html.nested", "source": "Click <b>Save</b> then <i>Publish</i>", "targetLocale": "de", "reference": "Klicke auf <b>Speichern</b> und dann auf <i>Veröffentlichen</i>", "traps": ["html", "nested-tags"] },
    { "id": "idiom.tagline", "source": "Hit the ground running", "targetLocale": "pt-BR", "reference": "Comece com tudo", "traps": ["idiom", "hard"] },
    { "id": "idiom.blast", "source": "Blast your growth", "targetLocale": "ja", "reference": "成長を加速させる", "traps": ["idiom", "marketing", "low-resource"] },
    { "id": "ambiguous.save.button", "source": "Save", "targetLocale": "de", "reference": "Speichern", "context": "button label", "traps": ["ambiguous", "needs-context"] },
    { "id": "ambiguous.save.prose", "source": "Save", "targetLocale": "de", "reference": "sparen", "context": "prose about saving money", "traps": ["ambiguous", "needs-context"] },
    { "id": "glossary.workspace", "source": "Open your workspace", "targetLocale": "pt-BR", "reference": "Abra seu workspace", "glossaryNeverTranslate": ["workspace"], "traps": ["glossary", "never-translate"] },
    { "id": "long.marketing", "source": "The all-in-one platform that helps your team ship faster, collaborate better, and delight your customers.", "targetLocale": "de", "reference": "Die All-in-One-Plattform, mit der dein Team schneller liefert, besser zusammenarbeitet und deine Kunden begeistert.", "traps": ["long", "marketing", "top-model"] },
    { "id": "tooltip.short", "source": "Copy to clipboard", "targetLocale": "fr", "reference": "Copier dans le presse-papiers", "traps": ["tooltip"] },
    { "id": "empty.state", "source": "No results found", "targetLocale": "es", "reference": "No se encontraron resultados", "traps": ["empty-state"] },
    { "id": "date.relative", "source": "{count, plural, one {# day ago} other {# days ago}}", "targetLocale": "ru", "reference": "{count, plural, one {# день назад} few {# дня назад} many {# дней назад} other {# дня назад}}", "traps": ["icu-plural", "russian"] },
