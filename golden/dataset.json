    { "id": "btn.cancel", "source": "Cancel", "targetLocale": "de", "reference": "Abbrechen", "traps": ["one-word-button"] },
    { "id": "btn.save.changes", "source": "Save changes", "targetLocale": "pt-BR", "reference": "Salvar alterações", "traps": ["button"] },
