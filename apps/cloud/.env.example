# LocaleCI Cloud — environment

# Database (Neon Postgres)
DATABASE_URL="postgres://user:pass@host/db?sslmode=require"

# Auth.js (GitHub OAuth)
AUTH_SECRET="run: openssl rand -base64 32"
AUTH_GITHUB_ID="your_github_oauth_app_id"
AUTH_GITHUB_SECRET="your_github_oauth_app_secret"

# Platform LLM keys (the cloud calls the provider with THESE)
LOCALECI_PLATFORM_PROVIDER="anthropic"   # anthropic | openai | mock
ANTHROPIC_API_KEY="sk-ant-..."
# OPENAI_API_KEY="sk-..."

# Zero-retention by default. Set to "true" ONLY to store content hashes.
LOCALECI_RETENTION="false"

# Stripe
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PRICE_PRO="price_..."
STRIPE_PRICE_TEAM="price_..."
STRIPE_PRICE_SCALE="price_..."

# Resend (transactional email)
RESEND_API_KEY="re_..."
