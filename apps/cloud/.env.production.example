# LocaleCI Cloud — production environment (consolidated).
# Copy to your Vercel Project → Settings → Environment Variables.
# Never commit real values. See docs/deploy.md for how each is used.

# ── App ─────────────────────────────────────────────────────────────────────
APP_URL="https://localeci.dev"                 # CSRF origin allow-list + otpauth
NODE_ENV="production"

# ── Database (Neon + pgvector) ──────────────────────────────────────────────
DATABASE_URL="postgres://user:pass@primary-host/db?sslmode=require"
DATABASE_URL_REPLICA="postgres://user:pass@replica-host/db?sslmode=require"  # optional (#18)

# ── Auth (Auth.js + GitHub OAuth) ───────────────────────────────────────────
AUTH_SECRET="run: openssl rand -base64 32"
AUTH_GITHUB_ID="your_github_oauth_app_id"
AUTH_GITHUB_SECRET="your_github_oauth_app_secret"

# ── Platform LLM keys ───────────────────────────────────────────────────────
LOCALECI_PLATFORM_PROVIDER="anthropic"          # anthropic | openai | mock
ANTHROPIC_API_KEY="sk-ant-..."
# OPENAI_API_KEY="sk-..."
LOCALECI_OPENAI_EMBED_MODEL="text-embedding-3-small"
LOCALECI_RETENTION="false"                       # zero-retention by default

# ── KV / Redis (Upstash) — rate limiting (#11) + hot TM cache (#18) ──────────
KV_REST_API_URL="https://<db>.upstash.io"
KV_REST_API_TOKEN="********"

# ── Observability (Sentry) (#9) ─────────────────────────────────────────────
SENTRY_DSN="https://<key>@o0.ingest.sentry.io/0"

# ── Guardrails (rate limits + spend caps) ───────────────────────────────────
PLAYGROUND_RATE_LIMIT="10"                        # requests / 60s per IP
PLAYGROUND_DAILY_CAP_USD="5"                      # global playground budget/day
ORG_DAILY_CAP_USD="50"                            # per-org LLM budget/day
RATE_PUBLIC="10"
RATE_AUTH="20"
RATE_WRITE="60"
RATE_TRANSLATE="120"

# ── Workers / cron auth ─────────────────────────────────────────────────────
WORKER_SECRET="run: openssl rand -hex 32"         # protects /api/worker + /api/retention

# ── Stripe (billing) ────────────────────────────────────────────────────────
STRIPE_SECRET_KEY="sk_live_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PRICE_PRO="price_..."
STRIPE_PRICE_TEAM="price_..."
STRIPE_PRICE_SCALE="price_..."

# ── Email (Resend) ──────────────────────────────────────────────────────────
RESEND_API_KEY="re_..."
